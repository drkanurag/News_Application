{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix news install",
  "buildCommand": "npm --prefix news run build",
  "outputDirectory": "news/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

